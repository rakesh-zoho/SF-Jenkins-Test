import path from 'path';
import { test } from '@playwright/test';
import { waitForSFLoad } from '../utils/sf-helpers.js';

const authStatePath = path.resolve(process.cwd(), 'reports/.auth-state.json');

export const sfTest = test.extend({
  // Claude fixed it: Use test.info() to access testInfo inside fixture (not as parameter)
  sfPage: async ({ browser }, use) => {
    // Claude fixed it: Get test info via test.info() to access outputDir for video recording
    const testInfo = test.info();

    const context = await browser.newContext({
      storageState: authStatePath,
      permissions: [],

      // Claude fixed it: Enable video recording with proper testInfo.outputDir and matching viewport size (1920x1080)
      recordVideo: {
        dir: testInfo.outputDir,
        size: { width: 1920, height: 1080 },
      },
    });

    const page = await context.newPage();

    try {
      const lightningHome = new URL(
        '/lightning/page/home',
        process.env.SF_URL
      ).toString();

      await page.goto(lightningHome, {
        waitUntil: 'domcontentloaded',
        timeout: 30000,
      });

      // ✅ PRIMARY: wait for SF UI readiness
      await waitForSFLoad(page);

      // ✅ EXTRA: ensure App Launcher is actually clickable
      const appLauncher = page.locator('[title="App Launcher"]').first();
      await appLauncher.waitFor({ state: 'visible', timeout: 20000 });

      // small buffer for rendering (helps video + stability)
      await page.waitForTimeout(1000);

      await use(page);

    } finally {
      await context.close();
    }
  },
});